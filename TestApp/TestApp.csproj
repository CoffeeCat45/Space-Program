<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- UnityAdapter хранится рядом с ядром, но не должен компилироваться в консольный .NET-проект. -->
    <Compile Remove="UnityAdapter\**\*.cs" />
  </ItemGroup>

</Project>
