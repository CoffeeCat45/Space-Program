{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build TestApp",
            "type": "shell",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}/TestApp/TestApp.csproj",
                "/property:GenerateFullPaths=true"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "run TestApp",
            "type": "shell",
            "command": "dotnet",
            "args": [
                "run",
                "--project",
                "${workspaceFolder}/TestApp/TestApp.csproj"
            ],
            "group": "test",
            "problemMatcher": "$msCompile"
        }
    ]
}
